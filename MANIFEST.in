include CITATION.cff
include .zenodo.json
include CHANGELOG.md
include REPRODUCIBILITY.md
include CONTRIBUTING.md
include requirements-lock.txt
include Dockerfile
include mkdocs.yml
recursive-include docs *.md *.yml *.png

include tests/conftest.py
# the workflow a test reads, so that the suite passes from the source distribution
include .github/workflows/ci.yml
include tests/mutation_survivors.json
# The fixtures and the committed artefacts the golden tests compare against;
# without them a suite run from the source distribution cannot check them.
recursive-include tests/golden *.yaml *.csv *.json *.md *.html
recursive-include benchmarks *.py *.R *.sh *.tsv *.md *.sbatch
recursive-include benchmarks/campaign *.txt
recursive-include scripts *.py *.sh
include scripts/reconcile_numbers.json
include examples/ssuis/*.yaml
include examples/ssuis/*.md
include examples/ssuis/*.py
include examples/ssuis/data/*
include examples/ssuis/expected/*
include examples/salmonella_poultry/*.yaml
include examples/salmonella_poultry/*.md
include examples/salmonella_poultry/*.py
include examples/salmonella_poultry/data/*
include examples/salmonella_poultry/expected_serovar/*
include examples/salmonella_poultry/expected_cluster/*
include examples/ecoli_swine/*.yaml
include examples/ecoli_swine/*.md
include examples/ecoli_swine/*.py
include examples/ecoli_swine/data/*
include examples/ecoli_swine/expected/*
include examples/ecoli_swine/expected_two_categories/*
include examples/ecoli_swine/expected_without_st410/*
include examples/ecoli_swine/expected_periods/*
include examples/ecoli_swine/expected_comparison/*
include examples/ecoli_swine/expected_comparison_clermont/*
include examples/ecoli_swine/input.csv
# The records the article's numbers are read from: the confirmatory verdicts
# and summaries, the empirical analyses, the calibration of the decomposition
# and the smaller benchmark records, so that scripts/reconcile_numbers.py runs
# from the source distribution.
recursive-include benchmarks/results_confirmatory *
recursive-include benchmarks/results_empirical *
recursive-include benchmarks/results_decomposition_calibration *
recursive-include benchmarks/results_decomposition_vs_regression *
recursive-include benchmarks/results_null_uniformity *
recursive-include benchmarks/results_repeated_looks *


recursive-include examples/workflows *.yaml *.md *.csv
recursive-include examples/matched_lineages *.md *.csv
